        "EON_REWARDED_DAILY_CAP": "3",
        "EON_REWARDED_COOLDOWN_MINUTES": "10",
        "EON_PREMIUM_CHECKOUT_ROLLOUT": "disabled"
      },
      "d1_databases": [
