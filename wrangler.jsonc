{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "eonapp-ch",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-08-05",
  "send_metrics": false,
  "upload_source_maps": true,
  "vars": {
    "EON_ENVIRONMENT": "local",
    "EON_RELEASE_AUTHORITY_ID": "a15-i21-v1",
    "APP_ORIGIN": "http://localhost:8788",
    "GOOGLE_REDIRECT_URI": "http://localhost:8788/api/auth/google/callback",
    "EON_AUTH_ROLLOUT": "disabled",
    "EON_BILLING_ROLLOUT": "disabled",
    "DODO_API_ENVIRONMENT": "test",
    "EON_REFERRAL_ROLLOUT": "disabled",
    "EON_PUSH_ROLLOUT": "disabled",
    "EON_VEXRAIL_ROLLOUT": "disabled",
    "EON_VEXRAIL_PROFIT_GOVERNOR_MODE": "observe",
    "EON_VEXRAIL_AI_COVERAGE_TARGET": "1.25",
    "EON_VEXRAIL_PROFIT_MIN_PROMPTS": "200",
    "EON_VEXRAIL_PROFIT_WINDOW_DAYS": "7",
    "EON_VEXRAIL_LEARNING_PROMPT_BUDGET": "50",
    "EON_VEXRAIL_LEARNING_LOSS_BUDGET_MICROS": "0",
    "EON_VEXRAIL_GUEST_ONE_SHOT": "false",
    "EON_VEXRAIL_GUEST_NETWORK_DAILY_CAP": "5",
    "EON_VEXRAIL_GUEST_MAX_OUTPUT_TOKENS": "768",
    "EON_VEXRAIL_GUEST_COOKIE_DAYS": "30",
    "EON_MONETIZATION_ROLLOUT": "disabled",
    "EON_MONETIZATION_ENABLED": "false",
    "EON_DISPLAY_ADS_ENABLED": "false",
    "EON_EXOCLICK_ENABLED": "false",
    "EON_EXOCLICK_NATIVE_ENABLED": "false",
    "EON_EXOCLICK_MULTIFORMAT_ENABLED": "false",
    "EON_EXOCLICK_OUTSTREAM_ENABLED": "false",
    "EON_SPONSOR_VIDEO_ENABLED": "false",
    "EON_REWARDED_ADS_ENABLED": "false",
    "EON_REWARDED_PROVIDER": "none",
    "EON_REWARDED_PROVIDER_VERIFIED": "false",
    "EON_REWARDED_DAILY_CAP": "3",
    "EON_REWARDED_COOLDOWN_MINUTES": "10",
    "EON_PREMIUM_CHECKOUT_ROLLOUT": "disabled"
  },
  "d1_databases": [
    {
      "binding": "EON_IDENTITY_DB",
      "database_name": "eonapp-identity-local",
      "database_id": "00000000-0000-0000-0000-000000000101",
      "migrations_dir": "identity/migrations"
    },
    {
      "binding": "EON_BILLING_DB",
      "database_name": "eonapp-billing-local",
      "database_id": "00000000-0000-0000-0000-000000000102",
      "migrations_dir": "migrations/billing"
    },
    {
      "binding": "EON_REFERRALS_DB",
      "database_name": "eonapp-referrals-local",
      "database_id": "00000000-0000-0000-0000-000000000103",
      "migrations_dir": "migrations/referrals"
    },
    {
      "binding": "EON_TRUST_DB",
      "database_name": "eonapp-trust-local",
      "database_id": "00000000-0000-0000-0000-000000000104",
      "migrations_dir": "migrations/trust"
    }
  ],
  "env": {
    "preview": {
      "vars": {
        "EON_ENVIRONMENT": "preview",
        "EON_RELEASE_AUTHORITY_ID": "a15-i21-v1",
