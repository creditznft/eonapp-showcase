+  if (current) current.textContent = url || '';
+  const title = $('ew-active-title');
+  if (title) title.textContent = label || 'Workstation';
+  const modeEl = $('ew-active-mode');
+  if (modeEl) modeEl.textContent = mode === 'external' ? 'External handoff' : mode === 'reader' ? 'Web reader' : mode === 'app' ? 'EON app' : 'Home';
+  const host = $('browser-frame-host');
+  if (host) host.dataset.ewMode = mode;
+  qa('[data-ew-mode]').forEach((btn) => btn.classList.toggle('active', btn.getAttribute('data-ew-mode') === mode));
+}
+
+function openInternalApp(url, label = '') {
+  const resolved = resolveInternalPath(url);
+  const app = WORKSTATION_APPS.find((item) => item.url === resolved || item.url.replace(/\.html$/, '') === resolved.replace(/\.html$/, ''));
+  const finalLabel = label || app?.label || resolved;
+  const frame = ensureViewportFrame();
+  if (!frame) return false;
+  frame.src = resolved;
+  updateChrome({ mode: 'app', url: resolved, label: finalLabel });
+  setLegacyStatus(`Opened ${finalLabel} inside EON Workstation.`, true);
+  markShortcutActive(resolved);
+  try {
+    window.EONTabSystem?.navigateCurrentTab?.(resolved);
+  } catch {}
+  return true;
+}
+
+function markShortcutActive(url = '') {
+  const resolved = resolveInternalPath(url);
+  qa('[data-url], [data-app-url], [data-ew-open]').forEach((el) => {
+    const candidate = el.getAttribute('data-url') || el.getAttribute('data-app-url') || el.getAttribute('data-ew-open') || '';
