+function $(id) { return document.getElementById(id); }
+function q(sel, root = document) { return root.querySelector(sel); }
+function qa(sel, root = document) { return Array.from(root.querySelectorAll(sel)); }
+function escapeHtml(value = '') {
+  return String(value).replace(/[&<>"']/g, (ch) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[ch]));
+}
+
+function setLegacyStatus(message, ok = true) {
+  const status = $('browser-status');
+  if (status) {
+    status.textContent = message;
+    status.classList.toggle('error', !ok);
+    status.classList.toggle('success', ok);
+  }
+  const rail = $('browser-operator-copy');
+  if (rail) rail.textContent = message;
+}
+
+function normalizeCommand(raw = '') {
+  const s = String(raw || '').trim();
+  if (!s) return '';
+  if (s.startsWith('/')) return s;
+  if (/^https?:\/\//i.test(s)) return s;
+  if (/^(chat|ai)$/i.test(s)) return '/chat.html';
+  if (/^(code|codemaker|code maker|ide)$/i.test(s)) return '/code-maker.html';
+  if (/^(vault|keys|backup)$/i.test(s)) return '/vault.html';
+  if (/^(market|marketplace|nft)$/i.test(s)) return '/marketplace.html';
+  if (/^(realm|eoncity|eon city|city)$/i.test(s)) return '/realm.html';
+  if (/^(creator|studio)$/i.test(s)) return '/creator-studio.html';
+  if (/^(reward|rewards|ads)$/i.test(s)) return '/reward-access.html';
+  if (s.includes('.') && !s.includes(' ')) return `https://${s}`;
+  return `https://www.google.com/search?q=${encodeURIComponent(s)}`;
+}
+
+function isInternalUrl(url = '') {
+  const normalized = normalizeCommand(url);
+  if (!normalized) return false;
+  if (normalized.startsWith('/')) return true;
+  try {
+    const host = new URL(normalized, window.location.origin).hostname.replace(/^www\./i, '').toLowerCase();
+    return INTERNAL_HOSTS.has(host) || host.endsWith('.eonapp.ch');
+  } catch {
+    return false;
+  }
+}
+
+function resolveInternalPath(url = '') {
+  const normalized = normalizeCommand(url);
+  if (!normalized) return '/';
+  if (normalized.startsWith('/')) return normalized;
+  try {
+    const parsed = new URL(normalized, window.location.origin);
+    if (isInternalUrl(parsed.href)) return `${parsed.pathname}${parsed.search}${parsed.hash}` || '/';
+  } catch {}
+  return normalized;
+}
+
+function ensureViewportFrame() {
+  const host = $('browser-frame-host');
+  if (!host) return null;
+  let frame = $('browser-frame');
+  if (!frame) {
+    frame = document.createElement('iframe');
+    frame.id = 'browser-frame';
+    frame.title = 'EON Workstation app viewport';
+    frame.className = 'browser-tab-frame ew-active-frame';
+    host.appendChild(frame);
+  }
+  frame.hidden = false;
+  frame.classList.add('ew-active-frame');
+  const newtab = $('eon-newtab-page');
+  if (newtab) newtab.hidden = true;
+  host.classList.remove('ew-external-mode', 'ew-home-mode');
+  return frame;
+}
+
+function updateChrome({ mode = state.activeMode, url = state.activeUrl, label = state.activeLabel } = {}) {
+  state.activeMode = mode;
+  state.activeUrl = url;
+  state.activeLabel = label;
+  const urlInput = $('browser-url');
+  if (urlInput) urlInput.value = url || '';
