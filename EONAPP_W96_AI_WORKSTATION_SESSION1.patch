+import fs from 'node:fs';
+import childProcess from 'node:child_process';
+
+function read(path) { return fs.readFileSync(path, 'utf8'); }
+function assert(name, ok, detail = '') {
+  checks.push({ name, ok: Boolean(ok), detail });
+}
+function nodeCheck(path) {
+  try {
+    childProcess.execFileSync(process.execPath, ['--check', path], { stdio: 'pipe' });
+    return true;
+  } catch (error) {
+    return false;
+  }
+}
+
+const checks = [];
+const browserHtml = read('eon-browser.html');
+const workstationJs = read('assets/js/eon-workstation-page.js');
+const browserCss = read('assets/css/eon-browser.css');
+const codeMakerHtml = read('code-maker.html');
+const codeMakerJs = read('assets/js/code-maker-page.js');
+const codeMakerCss = read('assets/css/code-maker.css');
+
+assert('browser html loads workstation module', browserHtml.includes('/assets/js/eon-workstation-page.js'));
+assert('browser title reframed as EON Workstation', /<title>EON Workstation \| EONAPP\.ch<\/title>/.test(browserHtml));
+assert('browser footer mojibake removed', !/[Â]|âš¡/.test(browserHtml));
+assert('workstation exposes public controller', workstationJs.includes('window.EONWorkstation'));
+assert('workstation has code maker app route', workstationJs.includes("url: '/code-maker.html'"));
+assert('workstation has external handoff mode', workstationJs.includes('showExternalHandoff') && workstationJs.includes('Open external tab'));
+assert('workstation has source reader mode', workstationJs.includes('fetchReadableIntoSource'));
+assert('workstation has home stage', workstationJs.includes('renderWorkstationHome'));
+assert('workstation js syntax clean', nodeCheck('assets/js/eon-workstation-page.js'));
+assert('code maker fallback editor implemented', codeMakerJs.includes('initFallbackEditor') && codeMakerJs.includes('cm-fallback-editor'));
+assert('code maker fallback timeout implemented', codeMakerJs.includes('Monaco CDN timed out or was blocked'));
+assert('code maker js syntax clean', nodeCheck('assets/js/code-maker-page.js'));
+assert('code maker html mojibake removed', !/[Â]|âš¡/.test(codeMakerHtml));
+assert('workstation responsive css added', browserCss.includes('.ew-command-deck') && browserCss.includes('@media (max-width: 1180px)'));
+assert('fallback editor css added', codeMakerCss.includes('.cm-fallback-editor'));
+
+const failed = checks.filter((item) => !item.ok);
+const report = {
+  schema: 'eon.w96.ai-workstation-gate.v1',
+  ok: failed.length === 0,
+  checks,
+  failed: failed.map((item) => item.name)
+};
+console.log(JSON.stringify(report, null, 2));
+if (failed.length) process.exit(1);
