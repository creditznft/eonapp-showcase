# W766IR2-F — formerly mutable core City models are rewritten at build time
# into /assets/city/immutable/...<sha12>.* and persist across releases.
/assets/city/immutable/*
  ! Cache-Control
  Cache-Control: public, max-age=31556952, immutable

# W766IR2-D — content-hashed City binaries are immutable across shell releases.
# New bytes must ship under a new hash-bearing URL; unchanged W649 and W659F
# assets remain browser-local and do not create repeat Cloudflare transfers.
/assets/city/w649/*
  ! Cache-Control
  Cache-Control: public, max-age=31556952, immutable

/assets/city/w659f/*
  ! Cache-Control
  Cache-Control: public, max-age=31556952, immutable

