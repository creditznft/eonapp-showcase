          "id": "signed-out",
          "request": "POST without a valid identity session",
          "expect": "401 signed_in_required"
        },
        {
          "id": "manifest-mismatch",
          "request": "POST for a digest other than the deployed manifest",
          "expect": "409 offline_manifest_mismatch"
        }
      ]
