      "id": "account-delete-request",
      "route": "/api/account/delete-request",
      "source": "functions/api/account/delete-request.js",
      "methods": [
        "POST"
      ],
      "state": "conditional",
      "identity": "signed-in minimal identity account only",
      "mutationGuard": "same-origin plus explicit DELETE_EON_ACCOUNT confirmation",
      "requestData": "confirmation literal only",
      "responseData": "safe deletion status only",
      "sensitiveData": "never returns account identifier, email, OAuth token, local work, Vault, provider key, payment or wallet data",
      "negativeCases": [
        {
          "id": "unconfigured",
          "request": "POST without exact identity configuration",
          "expect": "503 identity_unavailable"
        },
        {
          "id": "cross-origin",
          "request": "POST with a non-app Origin",
          "expect": "403 origin_check_failed"
        },
        {
          "id": "missing-confirmation",
          "request": "POST without exact confirmation literal",
          "expect": "400 explicit_confirmation_required"
        }
      ]
    },
