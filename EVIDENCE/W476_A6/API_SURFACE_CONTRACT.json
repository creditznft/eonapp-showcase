      "id": "csp-report",
      "route": "/csp-report",
      "source": "functions/csp-report.js",
      "methods": [
        "POST",
        "OPTIONS"
      ],
      "state": "active-privacy-bounded-telemetry",
      "identity": "none; anonymous browser reporting only",
      "mutationGuard": "same-origin reported document check; accepted JSON report formats only; strict size bound",
      "requestData": "CSP violation metadata only",
      "responseData": "204 no-content or safe validation error",
      "sensitiveData": "raw request body, cookies, credentials, query strings, fragments, raw referrer and signed token data are never retained or forwarded",
      "negativeCases": [
        {
          "id": "unsupported-media",
          "request": "POST with non-report Content-Type",
          "expect": "415 unsupported_media_type"
        },
        {
          "id": "invalid-json",
          "request": "POST with malformed JSON",
          "expect": "400 invalid_json"
        },
        {
          "id": "oversize",
          "request": "POST over 12 KiB",
          "expect": "413 report_too_large"
        },
        {
          "id": "foreign-document",
          "request": "POST with document URL outside request origin",
          "expect": "400 invalid_csp_document_origin"
        }
      ]
    }
