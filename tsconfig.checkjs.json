{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "types/**/*.d.ts",
    "sw.js",
    "assets/js/admin-page.js",
    "assets/js/campaign-admin-page.js",
    "assets/js/chat-page.js",
    "assets/js/chat/ai-runtime.js",
    "assets/js/chat/guide-mode-playbooks.js",
    "assets/js/creator-studio-page.js",
    "assets/js/eon-browser-page.js",
    "assets/js/free-ai-power-page.js",
    "assets/js/marketplace-page.js",
    "assets/js/nowpayments-status-page.js",
    "assets/js/realm-page.js",
    "assets/js/realmworld-page.js",
    "assets/js/signal-page.js",
    "assets/js/subscription-page.js",
    "assets/js/trust-showcase-page.js",
    "assets/js/vault-api-page.js",
    "assets/js/vault-page.js",
    "assets/js/workbench-page.js",
    "assets/js/utils/entitlements.js",
    "assets/js/utils/profile.js",
    "assets/js/utils/subscription.js",
    "assets/js/utils/realmworld-commerce-routing.js",
    "assets/js/utils/trade-cockpit-v2.js",
    "assets/js/utils/user-approved-social-scheduler.js"
  ],
  "exclude": [
    "node_modules",
    "tests",
    "**/test/**",
    "**/__tests__/**",
    "**/*.test.*",
    "**/*.spec.*",
    "e2e",
    "archive",
    "LEGACY_ARCHIVE_DEC20_2025",
    "games",
    "platform-backend/src/**/*.js"
  ]
}
